{
  "openapi": "3.0.1",
  "info": {
    "title": "Request service internal API",
    "description": "Внутренний API сервиса заявок на участие для межсервисного взаимодействия (используется Feign-клиентом ParticipationRequestClient из event-service).",
    "version": "v0"
  },
  "servers": [
    {
      "url": "http://localhost:{port}",
      "description": "Порт выдаётся сервису при запуске и может различаться",
      "variables": {
        "port": {
          "default": "8083",
          "description": "Порт request-service (динамический)"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "RequestInternalController",
      "description": "Внутренние эндпоинты для межсервисного взаимодействия"
    }
  ],
  "paths": {
    "/internal/{eventId}": {
      "get": {
        "tags": ["RequestInternalController"],
        "summary": "Получение всех заявок на участие в событии",
        "description": "Возвращает список заявок для заданного события. Используется Feign-клиентом ParticipationRequestClient (event-service).",
        "operationId": "findAllByEventId",
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "description": "Идентификатор события",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Список заявок",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ParticipationRequestDto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Некорректный идентификатор события"
          }
        }
      }
    },
    "/internal": {
      "get": {
        "tags": ["RequestInternalController"],
        "summary": "Получение заявок по списку идентификаторов",
        "description": "Возвращает список заявок по переданным идентификаторам. Используется Feign-клиентом ParticipationRequestClient (event-service).",
        "operationId": "findAllByIdIn",
        "parameters": [
          {
            "name": "ids",
            "in": "query",
            "description": "Список идентификаторов заявок",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int64"
              },
              "minItems": 1
            },
            "example": [1, 2, 3]
          }
        ],
        "responses": {
          "200": {
            "description": "Список заявок",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ParticipationRequestDto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Пустой или некорректный список идентификаторов"
          }
        }
      }
    },
    "/internal/counteventid": {
      "get": {
        "tags": ["RequestInternalController"],
        "summary": "Подсчёт заявок по событию и статусу",
        "description": "Возвращает количество заявок для заданного события с указанным статусом. Используется Feign-клиентом ParticipationRequestClient (event-service).",
        "operationId": "countByEventAndStatus",
        "parameters": [
          {
            "name": "eventId",
            "in": "query",
            "description": "Идентификатор события",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Статус заявки",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ParticipationStatus"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Количество заявок",
            "content": {
              "application/json": {
                "schema": {
                  "type": "integer",
                  "format": "int64",
                  "example": 5
                }
              }
            }
          },
          "400": {
            "description": "Некорректные параметры"
          }
        }
      }
    },
    "/internal/counteventids": {
      "get": {
        "tags": ["RequestInternalController"],
        "summary": "Подсчёт заявок по списку событий и статусу",
        "description": "Возвращает количество заявок для каждого из переданных событий с указанным статусом. Используется Feign-клиентом ParticipationRequestClient (event-service).",
        "operationId": "countByEventIdsAndStatus",
        "parameters": [
          {
            "name": "eventIds",
            "in": "query",
            "description": "Список идентификаторов событий",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int64"
              },
              "minItems": 1
            },
            "example": [1, 2, 3]
          },
          {
            "name": "status",
            "in": "query",
            "description": "Статус заявки",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ParticipationStatus"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Список пар [eventId, count]",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "description": "Массив пар: [идентификатор события, количество заявок]",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "example": [[1, 5], [2, 3]]
                }
              }
            }
          },
          "400": {
            "description": "Некорректные параметры"
          }
        }
      }
    },
    "/internal/reject": {
      "get": {
        "tags": ["RequestInternalController"],
        "summary": "Отклонение оставшихся заявок в статусе PENDING",
        "description": "Отклоняет все заявки события в статусе PENDING, кроме переданных в excludeIds. Используется Feign-клиентом ParticipationRequestClient (event-service).",
        "operationId": "rejectRemainingPending",
        "parameters": [
          {
            "name": "eventId",
            "in": "query",
            "description": "Идентификатор события",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          },
          {
            "name": "excludeIds",
            "in": "query",
            "description": "Идентификаторы заявок, которые нужно исключить из отклонения",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int64"
              }
            },
            "example": [1, 2]
          }
        ],
        "responses": {
          "200": {
            "description": "Количество отклонённых заявок",
            "content": {
              "application/json": {
                "schema": {
                  "type": "integer",
                  "format": "int32",
                  "example": 3
                }
              }
            }
          },
          "400": {
            "description": "Некорректные параметры"
          },
          "503": {
            "description": "Сервис недоступен"
          }
        }
      }
    },
    "/internal/confirmrequests": {
      "get": {
        "tags": ["RequestInternalController"],
        "summary": "Атомарное подтверждение заявок",
        "description": "Подтверждает заявки с учётом лимита участников. Используется Feign-клиентом ParticipationRequestClient (event-service).",
        "operationId": "confirmRequestsAtomically",
        "parameters": [
          {
            "name": "ids",
            "in": "query",
            "description": "Идентификаторы заявок для подтверждения",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int64"
              }
            },
            "example": [1, 2]
          },
          {
            "name": "eventId",
            "in": "query",
            "description": "Идентификатор события",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Лимит участников (0 — без ограничений)",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Количество подтверждённых заявок",
            "content": {
              "application/json": {
                "schema": {
                  "type": "integer",
                  "format": "int32",
                  "example": 2
                }
              }
            }
          },
          "400": {
            "description": "Некорректные параметры"
          },
          "503": {
            "description": "Сервис недоступен"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ParticipationRequestDto": {
        "type": "object",
        "description": "Заявка на участие в событии.",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "Идентификатор заявки",
            "example": 1
          },
          "created": {
            "type": "string",
            "description": "Дата и время создания заявки (yyyy-MM-dd HH:mm:ss)",
            "example": "2026-08-27 10:00:00"
          },
          "event": {
            "type": "integer",
            "format": "int64",
            "description": "Идентификатор события",
            "example": 1
          },
          "requester": {
            "type": "integer",
            "format": "int64",
            "description": "Идентификатор пользователя, создавшего заявку",
            "example": 2
          },
          "status": {
            "$ref": "#/components/schemas/ParticipationStatus"
          }
        }
      },
      "ParticipationStatus": {
        "type": "string",
        "description": "Статус заявки на участие",
        "enum": ["PENDING", "CONFIRMED", "REJECTED", "CANCELED"],
        "example": "PENDING"
      }
    }
  }
}